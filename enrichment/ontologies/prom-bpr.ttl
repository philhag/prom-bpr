  rdfs:label "Participation by applicant - collect & Assess statements" ;
  rdfs:subClassOf prom-bpr:A_1_1_PreConsultation ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onClass prom-bpr:A_1_1_1_ObtainSiteValidityCertificates ;
      owl:onProperty <https://w3id.org/ontobpr#afterActivity> ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    ] ;
.
