prom-bpr:A_1_1_1_ObtainSiteValidityCertificates
  rdf:type owl:Class ;
  rdfs:label "Obtain site validity certificates" ;
  rdfs:subClassOf prom-bpr:A_1_1_PreConsultation ;
.
prom-bpr:A_1_1_2_ParticipationByApplicant
