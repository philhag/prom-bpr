prom-bpr:EventLogCompound
  rdf:type owl:Class ;
  rdfs:label "Event log compund" ;
  rdfs:subClassOf <https://w3id.org/ontobpr#Activity> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onProperty prom-bpr:hasEventLogEntry ;
      owl:someValuesFrom prom-bpr:EventLogEntry ;
    ] ;
.
prom-bpr:EventLogEntry
  rdf:type owl:Class ;
  rdfs:label "Event log entry" ;
  rdfs:subClassOf prov:Activity ;
.
prom-bpr:UnclassifiedEventLogEntry
  rdf:type owl:Class ;
  rdfs:label "Unclassified event log entry" ;
  rdfs:subClassOf prom-bpr:EventLogEntry ;
.
prom-bpr:hasEventLogEntry
  rdf:type owl:ObjectProperty ;
  rdfs:domain prom-bpr:EventLogCompound ;
  rdfs:label "has event log entry" ;
  rdfs:range prom-bpr:EventLogEntry ;
  rdfs:subPropertyOf owl:topObjectProperty ;
.
