<https://w3id.org/ontobpr#Activity>
  rdfs:subClassOf prov:Activity ;
.
<https://w3id.org/ontobpr#afterActivity>
  rdf:type owl:ObjectProperty ;
.
<https://w3id.org/prom-bpr>
  rdf:type owl:Ontology ;
  dc:created "2026-01-19"^^xsd:date ;
  dc:creator [
      rdf:type schema:Person ;
      schema:email <mailto:judith.fauth@rub.de> ;
      schema:identifier <https://orcid.org/0000-0002-9078-8393> ;
      schema:memberOf [
          schema:identifier <https://www.linkedin.com/in/judith-fauth-5b5137bb> ;
          schema:name "Technical University of Munich, DE" ;
        ] ;
      schema:name "Dr. Judith Fauth" ;
    ] ;
  dc:creator [
      rdf:type schema:Person ;
      schema:email <mailto:philipp.hagedorn-n6v@rub.de> ;
      schema:identifier <https://orcid.org/0000-0002-6249-243X> ;
      schema:memberOf [
          schema:identifier <https://www.inf.bi.ruhr-uni-bochum.de/iib/lehrstuhl/mitarbeiter/philipp_hagedorn.html.en> ;
          schema:name "Ruhr University Bochum, DE" ;
        ] ;
      schema:name "Dr. Philipp Hagedorn" ;
    ] ;
  dc:creator [
      rdf:type schema:Person ;
      schema:email <mailto:ronny.weinkauf@hs-merseburg.de> ;
      schema:identifier <https://orcid.org/0009-0003-6827-0154> ;
      schema:memberOf [
          schema:identifier <https://www.hs-merseburg.de/hochschule/information/personenverzeichnis/details/person/weinkauf-ronny-613/> ;
          schema:name "Merseburg University of Applied Sciences, DE" ;
        ] ;
      schema:name "Prof. Dr. Ronny Weinkauf" ;
    ] ;
  dc:license <https://creativecommons.org/licenses/by/4.0/> ;
  dc:modified "2026-01-23"^^xsd:date ;
  dc:source "https://github.com/RUB-Informatik-im-Bauwesen/prom-bpr"^^xsd:anyURI ;
  dc:title "PROM-BPR"@en ;
  vann:preferredNamespacePrefix "prom-bpr" ;
  vann:preferredNamespaceUri "https://w3id.org/prom-bpr#"^^xsd:anyURI ;
  <http://purl.org/vocommons/voaf#extends> <https://w3id.org/ontobpr> ;
  rdfs:comment "PROM-BPR provides a reference process model for building permit review processes, capturing the key activities, their sequence, and dependencies for implementing process mining approaches. Furthermore, it contains classes for representing event log entries, unclassified event log entries, and event log compounds. The prefix of the ontology is <code>prom-bpr:</code>. The process model consists of three main phases: <code>prom-bpr:A_1_PrePhase</code>, <code>prom-bpr:A_2_ReviewPhase</code>, and <code>prom-bpr:A_3_PostPhase</code>. The ontology extends <code>ontobpr:</code> and utilizes <code>prov:</code>."@en ;
  
  owl:imports <http://www.w3.org/ns/prov-o#> ;
  owl:imports <https://w3id.org/ontobpr> ;
.
prom-bpr:A_1_1_1_ObtainSiteValidityCertificates
  rdf:type owl:Class ;
  rdfs:label "Obtain site validity certificates" ;
  rdfs:subClassOf prom-bpr:A_1_1_PreConsultation ;
.
prom-bpr:A_1_1_2_ParticipationByApplicant
  rdf:type owl:Class ;
  rdfs:label "Participation by applicant - collect & Assess statements" ;
  rdfs:subClassOf prom-bpr:A_1_1_PreConsultation ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onClass prom-bpr:A_1_1_1_ObtainSiteValidityCertificates ;
      owl:onProperty <https://w3id.org/ontobpr#afterActivity> ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    ] ;
.
prom-bpr:A_1_1_3_CompileApplicationRequestRequirementList
  rdf:type owl:Class ;
  rdfs:label "Compile application request requirement list" ;
  rdfs:subClassOf prom-bpr:A_1_1_PreConsultation ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:onClass prom-bpr:A_1_1_2_ParticipationByApplicant ;
      owl:onProperty <https://w3id.org/ontobpr#afterActivity> ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    ] ;
.
prom-bpr:A_1_1_4_ZoningReviewApplicant
  rdf:type owl:Class ;
  rdfs:label "Zoning review process by applicant" ;
  rdfs:subClassOf prom-bpr:A_1_1_PreConsultation ;
