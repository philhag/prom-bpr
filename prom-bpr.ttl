      rdf:type owl:Restriction ;
      owl:onClass prom-bpr:A_1_1_3_CompileApplicationRequestRequirementList ;
      owl:onProperty <https://w3id.org/ontobpr#afterActivity> ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    ] ;
.
prom-bpr:A_1_1_PreConsultation
